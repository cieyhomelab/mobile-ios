{
  "expo": {
    "name": ".bootstrap-scaffold",
    "slug": "bootstrap-scaffold",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bootstrapscaffold",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mkulesza.voiceassistant",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app records your voice while you hold the button to create calendar events.",
        "NSLocalNetworkUsageDescription": "Used during development to connect to the local Metro bundler."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mkulesza.voiceassistant",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.110934841502-93gettlb1arl7vmh2q1bm93s7mj78qar"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "This app records your voice while you hold the button to create calendar events."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39e2fc94-9b99-4c89-9a5b-4020d9d44253"
      }
    },
    "owner": "maciej.kulesza"
  }
}
